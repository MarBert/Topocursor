<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>TopoCursor</AssemblyName>
    <RootNamespace>TopoCursor</RootNamespace>
    <ApplicationIcon>assets\topo.ico</ApplicationIcon>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <Version>1.0.0</Version>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="tools\**" />
    <None Remove="tools\**" />
    <EmbeddedResource Include="assets\mouse.png" LogicalName="mouse.png" />
    <EmbeddedResource Include="assets\config.json" LogicalName="config.json" />
  </ItemGroup>

</Project>

<Project Sdk="Microsoft.NET.Sdk">

  <!-- TopoCursor for Linux (X11): no external packages, just P/Invoke into libX11/libXext/libXfixes/libXi. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>TopoCursor.Linux</RootNamespace>
    <AssemblyName>topocursor</AssemblyName>
    <Version>1.1.0</Version>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Core\TopoCursor.Core.csproj" />
  </ItemGroup>

</Project>
